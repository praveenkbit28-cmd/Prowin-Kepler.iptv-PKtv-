    def _media_search_ui(self, key, label, icon, media="podcast"):
        bar = ctk.CTkFrame(self.scroll, fg_color="transparent")
        bar.pack(fill="x", pady=6)
        entry = ctk.CTkEntry(bar, width=360, height=36, placeholder_text=f"Search {label}…",
                             fg_color=C["card"], border_color=C["glass_border"], corner_radius=12)
        entry.pack(side="left", padx=(0, 8))
        results = ctk.CTkFrame(self.scroll, fg_color="transparent")
        results.pack(fill="both", expand=True)
        nav = self._nav_id

        def do(q=None):
            q = (q or entry.get().strip() or key).strip()
            for w in safe_winfo_children(results):
                safe_destroy(w)
            # Instant local matches first (no wait)
            local_hits = _tv_filter([q, label], limit=40)
            if local_hits:
                self._fill_list(local_hits, results, nav, compact=True)
            else:
                ctk.CTkLabel(results, text=f"Searching {label}…", text_color=C["accent"]).pack(pady=10)

            def worker():
                items = list(local_hits)
                seen = {x[0].lower() for x in items}
                # 1) iTunes — short timeout, fewer results
                try:
                    if media in ("podcast", "audiobook", "music"):
                        entity = "podcast" if media == "podcast" else ("audiobook" if media == "audiobook" else "song")
                        media_type = "podcast" if media == "podcast" else ("audiobook" if media == "audiobook" else "music")
                        it_url = (
                            f"https://itunes.apple.com/search?term={requests.utils.quote(q)}"
                            f"&media={media_type}&entity={entity}&limit=20"
                        )
                        data = requests.get(
                            it_url, timeout=5,
                            headers={"User-Agent": "ProwinKepler/14"},
                        ).json()
                        for r in data.get("results") or []:
                            name = r.get("collectionName") or r.get("trackName") or r.get("artistName") or "Item"
                            artist = r.get("artistName") or ""
                            preview = r.get("previewUrl") or r.get("feedUrl") or r.get("episodeUrl")
                            title = f"{icon} {name} — {artist}"[:80]
                            if title.lower() in seen:
                                continue
                            if preview:
                                items.append((title, preview, "audio", ""))
                                seen.add(title.lower())
                            elif r.get("collectionViewUrl"):
                                items.append((title, r["collectionViewUrl"], "link", ""))
                                seen.add(title.lower())
                except Exception as e:
                    print(f"[iTunes {media}] {e}")

                # 2) YouTube — smaller search (fast)
                if YTDLP_AVAILABLE and len(items) < 25:
                    try:
                        yopts = {
                            "quiet": True, "no_warnings": True,
                            "extract_flat": True, "default_search": "ytsearch8",
                            "socket_timeout": 8,
                        }
                        with yt_dlp.YoutubeDL(yopts) as ydl:
                            info = ydl.extract_info(f"ytsearch8:{q} {label}", download=False)
                            for e in (info.get("entries") or []):
                                title = e.get("title") or label
                                url = e.get("url") or e.get("webpage_url") or f"https://www.youtube.com/watch?v={e.get('id')}"
                                t = f"▶ {title[:70]}"
                                if t.lower() not in seen:
                                    items.append((t, url, "video", ""))
                                    seen.add(t.lower())
                    except Exception as e:
                        print(f"[YT {media}] {e}")

                if not items:
                    items = [(f"No {label} found — try another search", "", "link", "")]

                def upd():
                    if nav != self._nav_id:
                        return
                    for w in safe_winfo_children(results):
                        safe_destroy(w)
                    self._fill_list(items[:200], results, nav, compact=(media != "video"))
                self._safe_after(0, upd)
            threading.Thread(target=worker, daemon=True).start()

        entry.bind("<Return>", lambda e: do())
        ctk.CTkButton(bar, text="Search", width=90, height=36, fg_color=C["accent"], text_color="#000",
                      corner_radius=12, font=ctk.CTkFont(weight="bold"), command=lambda: do()).pack(side="left", padx=2)
        ctk.CTkButton(bar, text="iTunes", width=80, height=36, fg_color=C["card2"],
                      corner_radius=12, command=lambda: do(entry.get().strip() or key)).pack(side="left", padx=2)
        do(key)

