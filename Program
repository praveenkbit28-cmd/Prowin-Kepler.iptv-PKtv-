VIDEO_EXTS = {".mp4", ".mkv", ".avi", ".webm", ".mov", ".flv", ".wmv", ".m4v", ".ts", ".m3u8"}
AUDIO_EXTS = {".mp3", ".m4a", ".aac", ".ogg", ".opus", ".flac", ".wav", ".wma", ".aiff"}

def _scan_local_media(folders, want="all", limit=500):
    items = []
    seen = set()
    for folder in folders:
        if not folder or not os.path.isdir(folder):
            continue
        try:
            for root, _dirs, files in os.walk(folder):
                for fn in files:
                    ext = os.path.splitext(fn)[1].lower()
                    if want == "video" and ext not in VIDEO_EXTS:
                        continue
                    if want == "audio" and ext not in AUDIO_EXTS:
                        continue
                    if want == "all" and ext not in VIDEO_EXTS | AUDIO_EXTS:
                        continue
                    full = os.path.join(root, fn)
                    if full in seen:
                        continue
                    seen.add(full)
                    mtype = "video" if ext in VIDEO_EXTS else "audio"
                    title = os.path.splitext(fn)[0]
                    items.append((title, full, mtype, ""))
                    if len(items) >= limit:
                        return items
        except Exception as e:
            print(f"[Local scan] {folder}: {e}")
    return items

