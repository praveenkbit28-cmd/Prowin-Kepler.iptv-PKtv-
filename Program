            if nav != self._nav_id:
                return
            if safe_exists(status):
                safe_destroy(status)
            self._fill_list(items, self.scroll, nav, compact=True)

        # Always use local data first (instant). No IPTV on critical path.
        try:
            items = build_items_fast()
            finish(items)
        except Exception as e:
            print(f"[TV] {e}")
            if safe_exists(status):
                safe_destroy(status)
            self._fill_list(
                [(n, u, t, "") for n, u, t in FREE_LIVE],
                self.scroll, nav, compact=True,
