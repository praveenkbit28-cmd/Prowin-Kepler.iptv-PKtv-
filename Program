    def _set_speed(self, rate):
        self._speed = rate
        if self.vlc_player and self._vlc_ready:
            try:
                self.vlc_player.set_rate(rate)
                self.now_sub.configure(text=f"Speed: {rate}x")
            except Exception:
                pass

    def _vol(self, v):
        vol = int(float(v))
        if self.vlc_player and self._vlc_ready:
            try:
                self.vlc_player.audio_set_mute(getattr(self, "_muted", False))
                self.vlc_player.audio_set_volume(vol)
            except Exception:
                pass
        elif PYGAME_AVAILABLE:
            try:
                pygame.mixer.music.set_volume(vol / 100)
            except Exception:
                pass

    def _download_current(self):
        url = getattr(self, "_current_play_url", "") or ""
        title = getattr(self, "_current_play_title", "") or "download"
        mtype = getattr(self, "_current_play_mtype", "") or "video"
        view = getattr(self, "_current_view", "") or ""

        if not url or mtype == "link":
            self.now_sub.configure(text="Nothing to download")
            return
        if not YTDLP_AVAILABLE:
            self.now_sub.configure(text="pip install -U yt-dlp required")
            return
        if not str(url).startswith("http"):
            self.now_sub.configure(text="Already a local file")
            return

        is_youtube = any(x in url.lower() for x in ("youtube.com", "youtu.be", "youtu"))
        is_audio_target = view.startswith(("music_", "pod_", "ab_")) or mtype == "audio"

        if not is_youtube and not is_audio_target:
            self.now_sub.configure(text="Download only for YT / Music / Podcast / Audiobook")
            return

        safe_name = re.sub(r'[\\/*?:"<>|]', "", title)[:80].strip() or "download"
        out_tmpl = os.path.join(self._download_dir, safe_name + ".%(ext)s")

        self.now_sub.configure(text="Downloading…")
        self._set_play_status("wait")

        def worker():
            try:
                if is_youtube and not is_audio_target:
                    yopts = {
                        "quiet": True,
                        "no_warnings": True,
                        "noplaylist": True,
                        "outtmpl": out_tmpl,
                        "format": "bestvideo[height<=1080]+bestaudio/best[height<=1080]/best",
                        "merge_output_format": "mp4",
                        "nocheckcertificate": True,
                    }
                else:
                    yopts = {
                        "quiet": True,
                        "no_warnings": True,
                        "noplaylist": True,
                        "outtmpl": out_tmpl,
                        "format": "bestaudio/best",
                        "postprocessors": [{
                            "key": "FFmpegExtractAudio",
                            "preferredcodec": "mp3",
                            "preferredquality": "192",
                        }],
                        "nocheckcertificate": True,
                    }
                with yt_dlp.YoutubeDL(yopts) as ydl:
                    ydl.download([url])
                self._safe_after(0, lambda: (
                    self.now_sub.configure(text=f"Saved → {self._download_dir}"),
                    self._set_play_status("play"),
                ))
            except Exception as e:
                print(f"[Download] {e}")
                self._safe_after(0, lambda: (
                    self.now_sub.configure(text=f"Download failed: {str(e)[:40]}"),
                    self._set_play_status("error"),
                ))
        threading.Thread(target=worker, daemon=True).start()

    def _show_lyrics(self, title):
        try:
            self._last_lyrics_title = title
            if not hasattr(self, "lyrics_box") or not safe_exists(self.lyrics_box):
                return
            self.lyrics_box.configure(state="normal")
            self.lyrics_box.delete("1.0", "end")
            self.lyrics_box.insert("end", f"♪  {title}\n\n")
            self.lyrics_box.insert("end", "Fetching lyrics…\n")
            self.lyrics_box.configure(state="disabled")
            def worker():
                text = (
                    f"♪  {title}\n\n"
                    f"Playing with auto-next enabled.\n"
                    f"Seek bar tracks progress.\n\n"
                    f"For full synced lyrics, open the YouTube lyric version of this song.\n"
                    f"Auto-subtitles load automatically for YouTube when available."
                )
                def upd():
                    if safe_exists(self.lyrics_box):
                        self.lyrics_box.configure(state="normal")
                        self.lyrics_box.delete("1.0", "end")
                        self.lyrics_box.insert("end", text)
                        self.lyrics_box.configure(state="disabled")
                self._safe_after(0, upd)
            threading.Thread(target=worker, daemon=True).start()
        except Exception:
            pass

    def _set_player_size(self, mode):
        sizes = {"S": 280, "M": 430, "L": 560, "XL": 720}
        h = sizes.get(mode, 430)
        self._size_mode = mode
        self._player_height = h
        try:
            self.player_frame.configure(height=h + 90)
            self.player_frame.pack_propagate(False)
            self._safe_after(200, self._bind_video_window)
            self._safe_after(500, self._bind_video_window)
            self.now_sub.configure(text=f"Screen size: {mode} ({h}px)")
        except Exception as e:
            print(f"[size] {e}")

    def _toggle_fullscreen(self):
        try:
            cur = self.attributes("-fullscreen")
            self.attributes("-fullscreen", not cur)
            self._safe_after(300, self._bind_video_window)
            self.now_sub.configure(text="Fullscreen ON" if not cur else "Fullscreen OFF")
        except Exception:
            try:
                if getattr(self, "_maximized", False):
                    self.geometry("1680x1060")
                    self._maximized = False
                else:
                    self.state("zoomed")
                    self._maximized = True
            except Exception as e:
                print(f"[fullscreen] {e}")


if __name__ == "__main__":
    App().mainloop()
