def parse_m3u(text, limit=20000):
    items = []
    name = None
    logo = ""
    for line in text.splitlines():
        line = line.strip()
        if not line:
            continue
        if line.startswith("#EXTINF"):
            m_logo = re.search(r'(?:tvg-logo|logo)="([^"]+)"', line, re.I)
            logo = m_logo.group(1) if m_logo else ""
            if "," in line:
                name = line.split(",", 1)[1].strip()
            else:
                name = "Channel"
            name = re.sub(r"\s*\[[^\]]*\]", "", name)
            name = re.sub(r"\s*\([^)]*\)", "", name)
            name = re.sub(r"\s+HD\b", "", name, flags=re.I)
            name = re.sub(r"\s+SD\b", "", name, flags=re.I)
            name = re.sub(r"\s+\d{3,4}p\b", "", name, flags=re.I)
            name = re.sub(r"\s{2,}", " ", name).strip()
            if not name or len(name) < 2:
                name = None
        elif line.startswith("http") and name:
            low = line.lower()
            if not any(x in low for x in (".jpg", ".png", ".gif", ".jpeg", ".svg", ".webp")):
                items.append((name, line, "video", logo))
            name = None
            logo = ""
            if len(items) >= limit:
                break
    seen = set()
    unique = []
    for item in items:
        k = item[0].lower().strip()
        if k not in seen:
            seen.add(k)
            unique.append(item)
    return unique

# Simple in-memory cache so the same IPTV category is not re-downloaded
_IPTV_CACHE = {}

def fetch_iptv(key, limit=200):
    """Fast IPTV-org fetch — short timeout, cached, small limit."""
    if key in _IPTV_CACHE:
        return _IPTV_CACHE[key][:limit]
    url = IPTV_SOURCES.get(key)
    if not url:
        return []
    try:
        r = requests.get(url, timeout=5, headers={"User-Agent": "Mozilla/5.0 (ProwinKepler/14)"})
        r.raise_for_status()
        items = parse_m3u(r.text, limit)
        _IPTV_CACHE[key] = items
        return items[:limit]
    except Exception as e:
        print(f"[IPTV {key}] {e}")
        return []

