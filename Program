def safe_winfo_children(w):
    try:
        return w.winfo_children() if w else []
    except tk.TclError:
        return []

def safe_destroy(w):
    try:
        if w:
            w.destroy()
    except tk.TclError:
        pass

def safe_exists(w):
    try:
        return w is not None and bool(w.winfo_exists())
    except tk.TclError:
        return False


