    def _init_vlc(self):
        if not VLC_AVAILABLE:
            self.now_sub.configure(text="Install VLC 64-bit from videolan.org")
            self.status.configure(text="● Offline", text_color=C["warning"])
            return
        try:
            self.video_panel.update_idletasks()
            hwnd = self.video_panel.winfo_id()
            if not hwnd:
                self._safe_after(500, self._init_vlc)
                return
            opts = [
                "--intf", "dummy",
                "--no-video-title-show",
                "--quiet",
                "--no-qt-privacy-ask",
                "--network-caching=3000",
                "--live-caching=3000",
                "--sout-mux-caching=3000",
                "--clock-jitter=0",
                "--clock-synchro=0",
            ]
            if sys.platform.startswith("linux"):
                opts.append("--no-xlib")
            self.vlc_instance = vlc.Instance(*opts)
            self.vlc_player = self.vlc_instance.media_player_new()
            self._bind_video_window()
            self._vlc_ready = True
            self.now_sub.configure(text="Select a channel")
            self.status.configure(text="● Online", text_color=C["success"])
        except Exception as e:
            print(f"[VLC] {e}")
            self.status.configure(text="● Offline", text_color=C["warning"])
            self._vlc_ready = False

    def _bind_video_window(self):
        if not self.vlc_player:
            return
        try:
            self.video_panel.update_idletasks()
            hwnd = int(self.video_panel.winfo_id())
            if sys.platform == "win32":
                self.vlc_player.set_hwnd(hwnd)
            elif sys.platform == "darwin":
                try:
                    self.vlc_player.set_nsobject(hwnd)
                except Exception:
                    self.vlc_player.set_hwnd(hwnd)
            else:
                self.vlc_player.set_xwindow(hwnd)
        except Exception as e:
            print(f"[VLC bind] {e}")

    def _play(self, title, url, mtype):
        if mtype == "link" or not url:
            self._logo(title, "No stream", mtype)
            self.now_sub.configure(text="No URL")
            self._set_play_status("stop")
            return
        # Ensure VLC is ready / re-bind video HWND (Windows often needs this)
        if VLC_AVAILABLE and not getattr(self, "_vlc_ready", False):
            try:
                self._init_vlc()
            except Exception as e:
                print(f"[VLC re-init] {e}")
        if VLC_AVAILABLE and self.vlc_player:
            try:
                self.vlc_player.stop()
            except Exception:
                pass
            self._bind_video_window()
        if not VLC_AVAILABLE:
            self.now_sub.configure(text="Install VLC 64-bit (same bitness as Python)")
            self._logo(title, "No VLC", mtype)
            self._set_play_status("error")
            print("[PLAY] VLC not available — install 64-bit VLC + pip install python-vlc")
            return
        self._logo(title, "Loading…", mtype)
        self.now_title.configure(text=title[:48])
        self.now_sub.configure(text="Waiting…")
        self._set_play_status("wait")
        self._current_play_url = url
        self._current_play_title = title
        self._current_play_mtype = mtype

        is_local = not str(url).startswith("http") and os.path.isfile(str(url))
        view = getattr(self, "_current_view", "") or ""
        is_tv = (
            view.startswith("tv_")
            or view.startswith("fm_")
            or view in ("tamilfm", "englishfm", "hindifm")
            or (mtype == "video" and not is_local and "youtube" not in (url or "").lower() and "youtu.be" not in (url or "").lower())
        )
        if view.startswith(("music_", "mov_", "yt_", "pod_", "ab_", "local_", "av_")) or "youtube" in (url or "").lower() or is_local:
            is_tv = False
        self._is_live_tv = is_tv

        # Live ON AIR label only for TV + FM
        try:
            if is_tv:
                self.live_lbl.configure(text="● ON AIR", text_color="#ff2244")
                self.progress.set(0)
                self.time_lbl.configure(text="--:--")
                self.dur_lbl.configure(text="LIVE")
            else:
                self.live_lbl.configure(text="")
        except Exception:
            pass

        if view.startswith(("yt_", "music_")):
            self._auto_next = True
        else:
            self._auto_next = False

        if mtype in ("audio", "video") and not is_tv:
            self._show_lyrics(title)
        try:
            self.current_media_index = next(
                i for i, (tt, u, m) in enumerate(self.current_media_items)
                if tt == title and u == url
            )
        except StopIteration:
            self.current_media_index = -1
        self._stop(keep=True)

        def worker():
            play_url = url
            try:
                if is_local:
                    play_url = url
                elif YTDLP_AVAILABLE and any(x in play_url for x in ("youtube.com", "youtu.be", "youtu")):
                    try:
                        yopts = {
                            "quiet": True, "no_warnings": True, "noplaylist": True,
                            "format": "best[height<=720][vcodec!=none][acodec!=none]/best[vcodec!=none][acodec!=none]/best",
                            "nocheckcertificate": True,
                            "writesubtitles": False,
                            "writeautomaticsub": False,
                        }
                        with yt_dlp.YoutubeDL(yopts) as ydl:
                            info = ydl.extract_info(play_url, download=False)
                            play_url = info.get("url") or play_url
                            if info.get("formats"):
                                if mtype == "audio":
                                    for f in reversed(info["formats"]):
                                        if f.get("url") and f.get("acodec") not in (None, "none"):
                                            play_url = f["url"]
                                            break
                                else:
                                    for f in reversed(info["formats"]):
                                        if (f.get("url") and
                                            f.get("vcodec") not in (None, "none") and
                                            f.get("acodec") not in (None, "none")):
                                            play_url = f["url"]
                                            break
                            subs_note = ""
                            if info.get("subtitles") or info.get("automatic_captions"):
                                subs_note = "\n\n[Auto-subtitles available on this video]"
                            desc = (info.get("description") or "")[:800]
                            if desc:
                                def _upd_sub(d=desc, t=title, n=subs_note):
                                    if safe_exists(getattr(self, "lyrics_box", None)):
                                        self.lyrics_box.configure(state="normal")
                                        self.lyrics_box.delete("1.0", "end")
                                        self.lyrics_box.insert("end", f"♪  {t}\n{n}\n\n{d}")
                                        self.lyrics_box.configure(state="disabled")
                                self._safe_after(0, _upd_sub)
                    except Exception as ye:
                        print(f"[yt-dlp] {ye}")
                        self._safe_after(0, lambda: (
                            self.now_sub.configure(text="Stream failed — try another"),
                            self._set_play_status("stop"),
                        ))
                        return

                if not (VLC_AVAILABLE and self.vlc_player):
                    self._safe_after(0, self._init_vlc)

                if VLC_AVAILABLE and self.vlc_player:
                    def start_vlc(u=play_url, ttl=title, mt=mtype, local=is_local):
                        try:
                            if not self._vlc_ready:
                                self._init_vlc()
                            self._bind_video_window()
                            try:
                                if mt == "audio":
                                    self.logo_canvas.place_forget()
                                    self._audio_mode()
                                else:
                                    self.logo_canvas.place_forget()
                                    self.audio_viz.place_forget()
                            except Exception:
                                pass
                            media = self.vlc_instance.media_new(u)
                            # Strong VLC options for live Tamil / Cartoon / IPTV HLS
                            is_live_stream = bool(getattr(self, "_is_live_tv", False)) or (
                                isinstance(u, str) and any(x in u.lower() for x in (".m3u8", ".m3u", "/hls/", "live"))
                            )
                            if not local:
                                if is_live_stream:
                                    media.add_option(":network-caching=4000")
                                    media.add_option(":live-caching=4000")
                                    media.add_option(":file-caching=2000")
                                    media.add_option(":sout-mux-caching=2000")
                                    media.add_option(":clock-jitter=0")
                                    media.add_option(":clock-synchro=0")
                                    media.add_option(":http-reconnect=true")
                                    media.add_option(":http-continuous=true")
                                    media.add_option(":hls-segment-threads=3")
                                else:
                                    media.add_option(":network-caching=2500")
                                    media.add_option(":live-caching=2500")
                                    media.add_option(":file-caching=1500")
                                    media.add_option(":http-reconnect=true")
                                media.add_option(":http-user-agent=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36")
                                media.add_option(":no-http-forward-cookies")
                            media.add_option(":avcodec-hw=any")
                            media.add_option(":avcodec-fast")
                            media.add_option(":sub-autodetect-file")
                            media.add_option(":sub-track=0")
                            # Prefer hardware when available; keep software fallback inside VLC
                            self.vlc_player.set_media(media)
                            try:
                                self.vlc_player.audio_set_mute(getattr(self, "_muted", False))
                                self.vlc_player.audio_set_volume(int(self.vol.get()))
                                self.vlc_player.set_rate(getattr(self, "_speed", 1.0))
                            except Exception:
                                pass
                            self._set_play_status("going" if not local else "local")
                            self.now_sub.configure(text="Starting…")
                            self.vlc_player.play()
                            self._safe_after(300, self._bind_video_window)
                            self._safe_after(800, self._bind_video_window)
                            self._safe_after(1200, self._start_progress)
                            self._safe_after(2000, lambda: self._check(ttl, mt))
                            self._safe_after(5000, lambda: self._check(ttl, mt))
                        except Exception as ex:
                            print(f"[VLC play] {ex}")
                            self._logo(ttl, "Failed", mt)
                            self.now_sub.configure(text="Play failed — try another")
                            self._set_play_status("stop")
                    self._safe_after(0, start_vlc)
                    return

                if mtype == "audio" and PYGAME_AVAILABLE and not is_local:
                    self._safe_after(0, lambda: self._audio_mode())
                    req = urllib.request.Request(play_url, headers={"User-Agent": "Mozilla/5.0"})
                    with urllib.request.urlopen(req, timeout=15) as r:
                        data = io.BytesIO(r.read())
                    pygame.mixer.music.load(data)
                    pygame.mixer.music.set_volume(self.vol.get() / 100)
                    pygame.mixer.music.play()
                    self._safe_after(0, lambda: (
                        self.now_sub.configure(text="Audio playing"),
                        self._set_play_status("play"),
                    ))
                    self._animate()
                else:
                    self._safe_after(0, lambda: (
                        self._logo(title, "Install VLC 64-bit", mtype),
                        self.now_sub.configure(text="Install VLC to play video"),
                        self._set_play_status("stop"),
                    ))
            except Exception as e:
                print(f"[Play] {e}")
                self._safe_after(0, lambda: (
                    self._logo(title, "Failed", mtype),
                    self.now_sub.configure(text="Try another channel"),
                    self._set_play_status("stop"),
                ))
        threading.Thread(target=worker, daemon=True).start()

    def _check(self, title, mtype):
        if not self.vlc_player:
            return
        try:
            state = self.vlc_player.get_state()
            if state in (vlc.State.Playing, vlc.State.Opening, vlc.State.Buffering):
                self.now_sub.configure(text="▶ Playing")
                status_mode = "play"
                if mtype == "audio":
                    status_mode = "radio"
                elif "youtube" in title.lower() or "yt" in title.lower():
                    status_mode = "yt"
                self._set_play_status(status_mode if state == vlc.State.Playing else "going")
                self._start_progress()

                if mtype == "audio":
                    try:
                        self.logo_canvas.place_forget()
                        self._audio_mode()
                        self._animate_vlc_audio()
                    except Exception:
                        pass
                else:
                    try:
                        self.logo_canvas.place_forget()
                        self.audio_viz.place_forget()
                    except Exception:
                        pass
            elif state == vlc.State.Ended:
                if getattr(self, "_loop", False):
                    self.vlc_player.set_time(0)
                    self.vlc_player.play()
                elif getattr(self, "_auto_next", False) and self.current_media_index >= 0:
                    self._safe_after(400, self._next)
                else:
                    self._set_play_status("stop")
                    self.now_sub.configure(text="Ended")
            else:
                self._logo(title, "Unavailable", mtype)
                self.now_sub.configure(text="Try Test Stream / another channel")
                self._set_play_status("error" if state == vlc.State.Error else "stop")
        except Exception:
            pass

    def _fmt_time(self, ms):
        if ms is None or ms < 0:
            return "00:00"
        s = int(ms // 1000)
        m, s = divmod(s, 60)
        h, m = divmod(m, 60)
        if h:
            return f"{h}:{m:02d}:{s:02d}"
        return f"{m:02d}:{s:02d}"

    def _start_progress(self):
        if getattr(self, "_is_live_tv", False):
            try:
                self.progress.set(0)
                self.time_lbl.configure(text="--:--")
                self.dur_lbl.configure(text="LIVE")
            except Exception:
                pass
            return
        if self._progress_job:
            try:
                self.after_cancel(self._progress_job)
            except Exception:
                pass
        self._update_progress()

    def _update_progress(self):
        try:
            if getattr(self, "_is_live_tv", False):
                try:
                    self.progress.set(0)
                    self.time_lbl.configure(text="--:--")
                    self.dur_lbl.configure(text="LIVE")
                except Exception:
                    pass
                return
            if not (self.vlc_player and self._vlc_ready):
                return
            state = self.vlc_player.get_state()
            if state == vlc.State.Ended:
                if getattr(self, "_loop", False):
                    self.vlc_player.set_time(0)
                    self.vlc_player.play()
                    return
                if getattr(self, "_auto_next", False):
                    self._safe_after(300, self._next)
                return
            if state not in (vlc.State.Playing, vlc.State.Paused, vlc.State.Buffering):
                return
            if not getattr(self, "_seek_dragging", False):
                length = self.vlc_player.get_length()
                pos = self.vlc_player.get_time()
                if length and length > 0:
                    self.progress.configure(to=max(1000, length))
                    self.progress.set(max(0, min(pos, length)))
                    self.time_lbl.configure(text=self._fmt_time(pos))
                    self.dur_lbl.configure(text=self._fmt_time(length))
                else:
                    self.progress.configure(to=1000)
                    self.progress.set(0)
                    self.time_lbl.configure(text=self._fmt_time(pos if pos > 0 else 0))
                    self.dur_lbl.configure(text="LIVE")
            self._progress_job = self.after(500, self._update_progress)
        except Exception:
            try:
                self._progress_job = self.after(1000, self._update_progress)
            except Exception:
                pass

    def _on_seek(self, value):
        if getattr(self, "_is_live_tv", False):
            return
        if not (self.vlc_player and self._vlc_ready):
            return
        try:
            self._seek_dragging = True
            ms = int(float(value))
            self.vlc_player.set_time(ms)
            self.time_lbl.configure(text=self._fmt_time(ms))
            self._safe_after(400, lambda: setattr(self, "_seek_dragging", False))
        except Exception:
            self._seek_dragging = False

    def _audio_mode(self):
        try:
            self.logo_canvas.place_forget()
            self.audio_viz.place(relx=0.5, rely=0.5, anchor="center", width=360, height=170)
        except Exception:
            pass

    def _animate(self):
        if not PYGAME_AVAILABLE:
            return
        try:
            if not pygame.mixer.music.get_busy():
                if getattr(self, "_auto_next", False):
                    self._safe_after(200, self._next)
                return
        except Exception:
            return
        for b in self._viz_bars:
            h = random.randint(12, 140)
            try:
                c = self.audio_viz.coords(b)
                self.audio_viz.coords(b, c[0], 90 - h // 2, c[2], 90 + h // 2)
            except Exception:
                return
        self._safe_after(90, self._animate)

    def _animate_vlc_audio(self):
        if not (VLC_AVAILABLE and self.vlc_player and self._vlc_ready):
            return
        try:
            state = self.vlc_player.get_state()
            if state == vlc.State.Ended:
                if getattr(self, "_loop", False):
                    self.vlc_player.set_time(0)
                    self.vlc_player.play()
                    return
                if getattr(self, "_auto_next", False):
                    self._safe_after(300, self._next)
                return
            if state not in (vlc.State.Playing,):
                return
        except Exception:
            return
        for b in self._viz_bars:
            h = random.randint(12, 140)
            try:
                c = self.audio_viz.coords(b)
                self.audio_viz.coords(b, c[0], 90 - h // 2, c[2], 90 + h // 2)
            except Exception:
                return
        self._safe_after(90, self._animate_vlc_audio)

    def _play_btn(self):
        if self.vlc_player and self._vlc_ready:
            self.vlc_player.play()
            self._start_progress()
            try:
                self.logo_canvas.place_forget()
            except Exception:
                pass
        elif PYGAME_AVAILABLE:
            try:
                pygame.mixer.music.unpause()
            except Exception:
                pass

    def _pause(self):
        if self.vlc_player and self._vlc_ready:
            self.vlc_player.pause()
        elif PYGAME_AVAILABLE:
            try:
                pygame.mixer.music.pause()
            except Exception:
                pass

    def _stop(self, keep=False):
        if self._progress_job:
            try:
                self.after_cancel(self._progress_job)
            except Exception:
                pass
            self._progress_job = None
        if self.vlc_player:
            try:
                self.vlc_player.stop()
            except Exception:
                pass
        if PYGAME_AVAILABLE:
            try:
                pygame.mixer.music.stop()
            except Exception:
                pass
        if not keep:
            self.now_title.configure(text="Nothing playing")
            self.now_sub.configure(text="Stopped")
            self._set_play_status("stop")
            self._logo("ProwinKepler", "Select media")
            try:
                self.progress.set(0)
                self.time_lbl.configure(text="00:00")
                self.dur_lbl.configure(text="00:00")
                self.live_lbl.configure(text="")
            except Exception:
                pass
        try:
            self.audio_viz.place_forget()
        except Exception:
            pass

    def _prev(self):
        if self.current_media_index > 0:
            self.current_media_index -= 1
            t, u, m = self.current_media_items[self.current_media_index]
            self._play(t, u, m)

    def _next(self):
        if not self.current_media_items:
            return
        if 0 <= self.current_media_index < len(self.current_media_items) - 1:
            self.current_media_index += 1
        else:
            self.current_media_index = 0
        t, u, m = self.current_media_items[self.current_media_index]
        self._play(t, u, m)

    def _seek(self, seconds):
        if getattr(self, "_is_live_tv", False):
            return
        if self.vlc_player and self._vlc_ready:
            try:
                t = self.vlc_player.get_time()
                if t >= 0:
                    self.vlc_player.set_time(max(0, t + seconds * 1000))
                    self._update_progress()
            except Exception:
                pass

    def _toggle_mute(self):
        self._muted = not getattr(self, "_muted", False)
        if self.vlc_player and self._vlc_ready:
            try:
                self.vlc_player.audio_set_mute(self._muted)
            except Exception:
                pass

    def _toggle_loop(self):
        self._loop = not getattr(self, "_loop", False)
        try:
            if self._loop:
