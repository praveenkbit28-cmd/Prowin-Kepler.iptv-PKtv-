    def _navigate(self, view):
        self._nav_id += 1
        self._current_view = view
        for w in safe_winfo_children(self.scroll):
            safe_destroy(w)
        self.current_media_items = []
        self.current_media_index = -1

        if view == "home":
            self._view_home()
        elif view.startswith("tv_"):
            self._view_tv(view)
        elif view.startswith("mov_"):
            self._view_movies(view)
        elif view.startswith("yt_"):
            self._view_youtube(view)
        elif view in ("tamilfm", "fm_local", "fm_all", "fm_trending", "fm_search") or view.startswith("fm_") or view in ("englishfm", "hindifm"):
            self._view_fm(view)
        elif view.startswith("music_"):
            self._view_music(view)
        elif view.startswith("ab_"):
            self._view_audiobooks(view)
        elif view.startswith("pod_"):
            self._view_podcasts(view)
        elif view.startswith("local_") or view == "av_open":
            self._view_local(view)
        elif view == "settings":
            self._view_settings()
        elif view == "ai":
            self._view_ai()
        elif view == "weather":
            self._view_weather()
        elif view in ("trending", "recommended"):
            self._view_home()
        else:
            self._h(view)
