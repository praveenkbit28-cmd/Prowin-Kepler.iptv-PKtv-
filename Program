def refresh_iptv_to_file(keys=None, limit_each=200):
    """Download IPTV-org lists and write tv.txt next to the app."""
    global ALL_TV, _ALL_TV_LOW, _TV_LOADED_FROM
    keys = keys or ["in", "us", "news", "sports", "entertainment", "movies", "kids", "music", "documentary"]
    items = []
    for k in keys:
        items.extend(fetch_iptv(k, limit=limit_each))
    seen = set()
    uniq = []
    for it in items:
        key = it[0].lower().strip()
        if key not in seen:
            seen.add(key)
            uniq.append(it)
    if not uniq:
        return 0
    try:
        with open(_TV_SAVE_PATH, "w", encoding="utf-8") as f:
            f.write("#EXTM3U\n")
            for name, url, *_r in uniq:
                f.write(f"#EXTINF:-1,{name}\n{url}\n")
        ALL_TV = uniq
        _ALL_TV_LOW = [(c, c[0].lower()) for c in ALL_TV]
        _TV_LOADED_FROM = _TV_SAVE_PATH
        print(f"[TV] Refreshed {len(ALL_TV)} → {_TV_SAVE_PATH}")
        return len(ALL_TV)
    except Exception as e:
        print(f"[TV] refresh write failed: {e}")
        return 0

def _tv_filter(keywords, source=None, limit=400):
    """Fast local filter — no network. Default cap 400 for UI speed."""
    if source is not None:
        pairs = [(c, c[0].lower()) for c in source]
    else:
        pairs = _ALL_TV_LOW
    if not pairs:
        return []
    keys = [k.lower() for k in keywords if k]
    if not keys:
        return [c for c, _ in pairs[:limit]]
    out = []
    for c, low in pairs:
        if any(k in low for k in keys):
            out.append(c)
            if len(out) >= limit:
                break
    return out

