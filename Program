        def build_items_fast():
            """Local-only, no network — instant from tv.txt + curated lists."""
            items = []
            if view == "tv_all" or not keys:
                items = list(ALL_TV[:400]) if ALL_TV else []
            else:
                items = list(_tv_filter(keys, limit=300))

            seen = {x[0].lower() for x in items}

            if view == "tv_tamil":
                for t in reversed(TAMIL_TV):
                    k = t[0].lower()
                    if k not in seen:
                        items.insert(0, (t[0], t[1], t[2], ""))
                        seen.add(k)
            elif view in ("tv_cartoon", "tv_kids"):
