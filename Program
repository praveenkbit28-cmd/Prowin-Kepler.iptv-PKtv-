    def _show_banner(self):
        try:
            self._banner = ctk.CTkFrame(self, fg_color="#030b0f", corner_radius=0)
            self._banner.place(relx=0, rely=0, relwidth=1, relheight=1)
            self._banner_cv = tk.Canvas(self._banner, bg="#030b0f", highlightthickness=0)
            self._banner_cv.pack(fill="both", expand=True)
            self.update_idletasks()
            w = max(self.winfo_width(), 900)
            h = max(self.winfo_height(), 600)
            self._banner_cv.create_rectangle(0, 0, w, h, fill="#030b0f", outline="")
            self._banner_cv.create_oval(w*0.05, h*0.15, w*0.55, h*0.95, fill="#0a2830", outline="")
            self._banner_cv.create_oval(w*0.4, h*0.0, w*0.98, h*0.7, fill="#061820", outline="")
            for _ in range(220):
                x, y = random.randint(0, w), random.randint(0, h)
                s = random.choice([1, 1, 1, 2, 3])
                col = random.choice(["#ffffff", "#a8fff0", "#ffb8e0", "#c8f0ff"])
                self._banner_cv.create_oval(x, y, x+s, y+s, fill=col, outline="")
            cx, cy = w//2, h//2 - 20
            self._banner_cv.create_oval(cx-120, cy-100, cx+120, cy+110, outline=C["accent"], width=2)
            self._banner_cv.create_oval(cx-100, cy-84, cx+100, cy+94, fill="#041418", outline="#1a5a6e", width=1)
            self._banner_cv.create_text(cx, cy-20, text="◈", font=("Segoe UI", 42), fill=C["accent"])
            self._banner_cv.create_text(cx, cy+40, text="ProwinKepler", font=("Segoe UI", 34, "bold"), fill="#e8fbff")
            self._banner_cv.create_text(cx, cy+78, text="LIVE · LIBRARY · NEON AURORA", font=("Segoe UI", 13), fill=C["accent2"])
            self._banner_cv.create_text(cx, h-40, text="Loading your universe…", font=("Segoe UI", 12), fill="#6a9aaa")
            self._banner_stars = True
            self._animate_banner(0)
            self.after(2600, self._hide_banner)
        except Exception as e:
            print(f"[Banner] {e}")
            try:
                self._hide_banner()
            except Exception:
                pass

    def _animate_banner(self, step):
        if not getattr(self, "_banner_stars", False):
            return
        try:
            if not safe_exists(self._banner_cv):
                return
            w = max(self._banner_cv.winfo_width(), 400)
            h = max(self._banner_cv.winfo_height(), 300)
            for _ in range(8):
                x, y = random.randint(0, w), random.randint(0, h)
                s = random.choice([1, 2, 3])
                self._banner_cv.create_oval(x, y, x+s, y+s, fill="#ffffff", outline="")
            self.after(120, lambda: self._animate_banner(step + 1))
        except Exception:
            pass

    def _hide_banner(self):
        self._banner_stars = False
        try:
            if getattr(self, "_banner", None):
                self._banner.place_forget()
                self._banner.destroy()
                self._banner = None
        except Exception:
            pass

