    def _send_ai(self):
        text = self.ai_inp.get().strip()
        if not text or not safe_exists(self.chat):
            return
        self.ai_inp.delete(0, "end")
        self.chat.configure(state="normal")
        self.chat.insert("end", f"You: {text}\n")
        self.chat.configure(state="disabled")
        key = self.ai_api_key.get().strip()
        if not key:
            self.chat.configure(state="normal")
            self.chat.insert("end", "AI: Enter API key\n\n")
            self.chat.configure(state="disabled")
            return
        def worker():
            try:
                r = requests.post("https://api.openai.com/v1/chat/completions",
                                  headers={"Authorization": f"Bearer {key}", "Content-Type": "application/json"},
                                  json={"model": "gpt-3.5-turbo", "messages": [{"role": "user", "content": text}]}, timeout=25)
                reply = r.json()["choices"][0]["message"]["content"]
                def upd():
                    if safe_exists(self.chat):
                        self.chat.configure(state="normal")
                        self.chat.insert("end", f"AI: {reply}\n\n")
                        self.chat.configure(state="disabled")
                self._safe_after(0, upd)
            except Exception as e:
                def err():
                    if safe_exists(self.chat):
                        self.chat.configure(state="normal")
                        self.chat.insert("end", f"AI: {e}\n\n")
                        self.chat.configure(state="disabled")
                self._safe_after(0, err)
        threading.Thread(target=worker, daemon=True).start()

