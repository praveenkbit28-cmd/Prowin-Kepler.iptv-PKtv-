def _parse_m3u_file(path):
    if not os.path.isfile(path):
        return []
    try:
        with open(path, "r", encoding="utf-8", errors="ignore") as f:
            text = f.read().replace("\r\n", "\n").replace("\r", "\n")
        return parse_m3u(text, limit=25000)
    except Exception as e:
        print(f"[M3U file] {e}")
        return []

