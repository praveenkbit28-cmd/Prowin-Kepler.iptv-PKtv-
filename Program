    def _fill_list(self, items, parent, nav=None, compact=False):
        """Render media list in the scroll area BELOW the player (never a new window).
        compact=True → fast row list (TV/FM); False → card grid (home / search)."""
        if nav is not None and nav != self._nav_id:
            return
        if not safe_exists(parent):
            return

        # Keep header labels already packed; only clear previous list containers
        # by destroying everything then re-showing is handled by callers that
        # already cleared on navigate. Here we just append list content.
        # If parent still has a loading label, remove non-header children carefully:
        # Callers pass a clean parent after status destroy.

        norm = []
        for it in items:
            if not it:
                continue
            if len(it) >= 4:
                norm.append((it[0], it[1], it[2], it[3]))
            elif len(it) == 3:
                norm.append((it[0], it[1], it[2], ""))
            elif len(it) == 2:
                norm.append((it[0], it[1], "video", ""))
        self.current_media_items = [(t[0], t[1], t[2]) for t in norm]

        count_lbl = ctk.CTkLabel(
            parent,
            text=f"  {len(norm)} items · click Play · stays in this window",
            font=ctk.CTkFont(size=11),
            text_color=C["muted"],
        )
        count_lbl.pack(anchor="w", pady=(0, 6))

        if not norm:
            empty_box = ctk.CTkFrame(parent, fg_color=C["glass"], corner_radius=16,
                                     border_width=1, border_color=C["glass_border"])
            empty_box.pack(pady=28, padx=40, fill="x")
            ctk.CTkLabel(empty_box, text="No channels found in this category",
                         font=ctk.CTkFont(size=14, weight="bold"), text_color=C["accent"]).pack(pady=(18, 6))
            ctk.CTkLabel(empty_box, text="Try All Channels, News, or Search — or check tv.txt is next to the app.",
                         font=ctk.CTkFont(size=11), text_color=C["muted"]).pack(pady=(0, 18))
            return

        # -------- COMPACT ROW LIST (TV / FM — modern alternating rows) --------
        if compact:
            list_fr = ctk.CTkFrame(parent, fg_color="transparent")
            list_fr.pack(fill="both", expand=True, pady=2)
            max_show = min(len(norm), 250)  # keep UI snappy

            for i, (title, url, mtype, logo_url) in enumerate(norm[:max_show]):
                if not safe_exists(parent):
                    return
                is_local = not str(url).startswith("http")
                low_t = (title or "").lower()
                if is_local:
                    badge, bcol = "LOCAL", C["accent2"]
                elif mtype == "audio" or "fm" in low_t or "radio" in low_t:
                    badge, bcol = "FM", C["success"]
                else:
                    badge, bcol = "LIVE", C["stop_btn"]
                icon = "📁" if is_local else ("📻" if mtype == "audio" else "📺")
                row_bg = C["row"] if i % 2 == 0 else C["row_alt"]

                row = ctk.CTkFrame(
                    list_fr, fg_color=row_bg, corner_radius=12,
                    border_width=1, border_color=C["glass_border"], height=54,
                )
                row.pack(fill="x", padx=2, pady=2)
                row.pack_propagate(False)

                # Icon chip
                chip = ctk.CTkFrame(row, width=40, height=40, fg_color=C["card"], corner_radius=10)
                chip.pack(side="left", padx=(8, 6), pady=6)
                chip.pack_propagate(False)
                ctk.CTkLabel(chip, text=icon, font=ctk.CTkFont(size=16),
                             text_color=C["accent"]).pack(expand=True)

                mid = ctk.CTkFrame(row, fg_color="transparent")
                mid.pack(side="left", fill="x", expand=True)
                ctk.CTkLabel(mid, text=(title or "Channel")[:68],
                             font=ctk.CTkFont(size=13, weight="bold"),
                             text_color=C["fg"], anchor="w").pack(anchor="w")
                ctk.CTkLabel(mid, text=f"● {badge}   #{i+1}",
                             font=ctk.CTkFont(size=10, weight="bold"),
                             text_color=bcol, anchor="w").pack(anchor="w")
                ctk.CTkButton(
                    row, text="▶  Play", width=86, height=32,
                    fg_color=C["play_btn"], text_color="#001018",
                    corner_radius=16, font=ctk.CTkFont(size=12, weight="bold"),
                    hover_color="#00d4b8",
                    command=lambda tt=title, u=url, m=mtype: self._play(tt, u, m),
                ).pack(side="right", padx=10)
            if len(norm) > max_show:
                ctk.CTkLabel(list_fr,
                             text=f"Showing first {max_show} of {len(norm)} — use Search to narrow",
                             text_color=C["muted"], font=ctk.CTkFont(size=11)).pack(pady=8)
            return

        # -------- CARD GRID (home / smaller lists) --------
        grid = ctk.CTkFrame(parent, fg_color="transparent")
        grid.pack(fill="both", expand=True, pady=4)
        cols = 3
        colors = ["#0a2a32", "#0e1a28", "#0a2a1a", "#1a2030", "#0a2830", "#0a2525", "#122830"]

        for i, (title, url, mtype, logo_url) in enumerate(norm[:300]):
            if not safe_exists(parent):
                return
            r, c = divmod(i, cols)
            card = ctk.CTkFrame(grid, width=340, height=168, fg_color=C["glass"],
                                corner_radius=14, border_width=1, border_color=C["glass_border"])
            card.grid(row=r, column=c, padx=8, pady=8, sticky="nsew")
            card.pack_propagate(False)
            bg = colors[i % len(colors)]

            thumb_fr = ctk.CTkFrame(card, height=72, fg_color=bg, corner_radius=10)
            thumb_fr.pack(fill="x", padx=8, pady=(8, 4))
            thumb_fr.pack_propagate(False)

            clean = (title or "").replace("📻 ", "").replace("📺 ", "").strip()
            letter = (clean[:1] or "◆").upper()
            is_local = not str(url).startswith("http")
            icon = "📁" if is_local else ("📺" if mtype == "video" else ("📻" if mtype == "audio" else "▶"))

            ctk.CTkLabel(thumb_fr, text=f"{icon}  {letter}", font=ctk.CTkFont(size=18, weight="bold"),
                         text_color="#ffffff").pack(pady=16)

            ctk.CTkLabel(card, text=(title or "")[:42], font=ctk.CTkFont(size=12, weight="bold"),
                         text_color=C["fg"], anchor="w").pack(fill="x", padx=10, pady=(2, 0))
            meta = "● LOCAL" if is_local else ("● ON AIR" if mtype == "video" else "📻 LIVE")
            ctk.CTkLabel(card, text=meta, font=ctk.CTkFont(size=9),
                         text_color=C["muted"], anchor="w").pack(fill="x", padx=10)

            bot = ctk.CTkFrame(card, fg_color="transparent")
            bot.pack(fill="x", padx=8, pady=(4, 8))
            ctk.CTkButton(bot, text="▶ Play", width=80, height=28, fg_color=C["accent"], text_color="#000",
                          corner_radius=8, font=ctk.CTkFont(size=12, weight="bold"),
                          command=lambda tt=title, u=url, m=mtype: self._play(tt, u, m)).pack(side="right")

        for c in range(cols):
            grid.grid_columnconfigure(c, weight=1)

